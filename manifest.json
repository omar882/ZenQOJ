{
  "manifest_version": 3,
  "name": "ZenQOJ: Peaceful QOJ",
  "version": "1.0.0",
  "description": "Removes ratings, rankings, solve statistics, and testcase spoilers from QOJ.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ZenQOJ"
  },
  "content_scripts": [
    {
      "matches": [
        "https://qoj.ac/*",
        "https://*.qoj.ac/*"
      ],
      "css": ["styles.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
